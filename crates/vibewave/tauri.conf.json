{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeWave",
  "version": "0.1.0",
  "identifier": "dev.vibewave.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
